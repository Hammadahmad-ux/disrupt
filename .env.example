# Contact form email. Use ONE of the two options. Without either: dev logs enquiries to the console, production shows an error.
# Option A: Resend (resend.com). The sending domain must be verified in Resend (DNS records).
RESEND_API_KEY=
# Sender for Resend, on the verified domain, e.g. DISRUPT website <hello@yourdomain.com>
CONTACT_FROM=
# Option B: a mailbox on the hosting account (SMTP).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where enquiries go (default contact@disruptstudio.co.uk).
CONTACT_TO=contact@disruptstudio.co.uk

# Public site address (canonical URLs, share images, sitemap). Set before `npm run build`.
NEXT_PUBLIC_SITE_URL=https://disrupt-demo.vercel.app
