# Contact form email: the hosting mailbox (SMTP). Without SMTP_USER/SMTP_PASS: dev logs enquiries to the console, production shows an error.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@disruptstudio.co.uk
SMTP_PASS=
# Where enquiries go (default contact@disruptstudio.co.uk). Sender defaults to SMTP_USER; it must be that mailbox.
CONTACT_TO=contact@disruptstudio.co.uk
# CONTACT_FROM=DISRUPT website <contact@disruptstudio.co.uk>

# Public site address (canonical URLs, share images, sitemap). Set before `npm run build`.
NEXT_PUBLIC_SITE_URL=https://disrupt-demo.vercel.app
